{
  "name": "@nmforge/customize-resolver",
  "version": "0.2.0-alpha.0",
  "description": "Resolves customize.toml in 3 layers (shipped → team → user) with deep merge, in pure Node (no Python subprocess).",
  "license": "MIT",
  "author": "Vinicius Caetano / Negócios Modernos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinicius-negocios-modernos/nmforge.git",
    "directory": "packages/customize-resolver"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
