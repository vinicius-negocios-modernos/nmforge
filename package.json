{
  "name": "nmforge-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "NMforge — Framework Node-nativo de orquestração de agentes para Claude Code 2.1.x. Monorepo root.",
  "author": "Vinicius Caetano <negociosmodernos7@gmail.com>",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "typecheck": "pnpm -r typecheck",
    "validate": "node packages/cli/bin/nmforge.js validate",
    "validate:strict": "node packages/cli/bin/nmforge.js validate --strict",
    "ci": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^9.18.0",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.21": "^1.1.21",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "vite@>=7.0.0 <7.3.5": "^7.3.5",
      "esbuild@>=0.27.3 <0.28.1": "^0.28.1"
    }
  }
}
